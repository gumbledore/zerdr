#!/usr/bin/env bash
# zh — glue between Zed and the herdr-app agents.
#   zh send [root]   ctrl-space: focus the repo's agent, or paste the selection (no Enter)
#   zh add [root]    ctrl-shift-space: queue selection (or cursor line) + one-line note
#   zh clear [root]  drop the repo's batch
# With a batch, send submits it (after prompting a note for any selection).
# Zed task env supplies ZED_FILE, ZED_ROW, ZED_SELECTED_TEXT, ZED_WORKTREE_ROOT; positional
# args (root, file, row) are only a fallback. Mutating commands hold a lock on the batch dir.
set -euo pipefail

TERM_CLASS=${ZH_TERMINAL_CLASS:-herdr-app}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/zerdr

notify() { notify-send "zh" "$1" 2>/dev/null || true; }
root_of() { [[ -n ${1:-} ]] || return 1; git -C "$1" rev-parse --show-toplevel 2>/dev/null || echo "$1"; }
lock() { mkdir -p "$STATE/batch" && exec 9>"$STATE/batch/.lock" && flock 9; }

# batch file for a git root: one per root, items {path, lines, selection, note}
batch_file() { echo "$STATE/batch/$(sha1sum <<<"$1" | cut -c1-16).json"; }
batch_count() { local f; f=$(batch_file "$1"); [[ -s $f ]] && jq 'length' "$f" || echo 0; }

# Target agent terminal for a git root: the one last focused in herdr-app if it is among
# the repo's local, live, status-reporting terminals, else blocked > done > working > idle.
# Prints "<terminal> <status>"; fails when there is none.
target_for() {
  local cands cwd t s focused
  cands=$(hc ls --json | jq -r '.terminals[]
    | select((.address | contains("/") | not) and (.machine == null) and .state == "live" and .status != null)
    | "\(.address)\t\(.status)\t\(.cwd // "")"')
  focused=$(herdr-app status 2>/dev/null | jq -r '.agent // empty' 2>/dev/null || true)
  local -a ids=() sts=()
  while IFS=$'\t' read -r t s cwd; do
    [[ -n $t ]] || continue
    # ls reports the launch folder; the current one is foreground.cwd of `hc get`
    cwd=$(hc get "$t" --json 2>/dev/null | jq -r --arg d "$cwd" '.foreground.cwd // .cwd // $d' 2>/dev/null) || cwd=""
    [[ $(root_of "$cwd") == "$1" ]] || continue
    ids+=("$t") sts+=("$s")
  done <<<"$cands"
  ((${#ids[@]})) || return 1
  local i best=-1 bestrank=9 rank
  for i in "${!ids[@]}"; do
    [[ -n $focused && ${ids[i]} == "$focused" ]] && { echo "${ids[i]} ${sts[i]}"; return 0; }
    case ${sts[i]} in blocked) rank=0 ;; done) rank=1 ;; working) rank=2 ;; idle) rank=3 ;; *) rank=4 ;; esac
    ((rank < bestrank)) && { best=$i bestrank=$rank; }
  done
  echo "${ids[best]} ${sts[best]}"
}

# focus an agent and raise the herdr-app window; fails if the agent cannot be focused
focus() {
  herdr-app do agent.focus --terminal "$1" >/dev/null || return 1
  # Hyprland >= 0.56 takes Lua dispatchers; older takes the classic syntax
  if command -v hyprctl >/dev/null; then
    hyprctl dispatch "hl.dsp.focus({ window = \"class:$TERM_CLASS\" })" | grep -q '^ok' ||
      hyprctl dispatch focuswindow "class:$TERM_CLASS" >/dev/null || true
  fi
}

# paste text into the focused terminal without Enter (hc send always presses Enter and
# hc keys cannot type arbitrary text), via the clipboard, which is restored afterwards.
paste_focused() {
  local tmp type rc=0
  tmp=$(mktemp) || return 1
  # no pipe: under pipefail a SIGPIPE would blank $type and the restore would wipe the clipboard
  type=""
  if wl-paste --list-types >"$tmp" 2>/dev/null; then read -r type <"$tmp" || true; fi
  if [[ -n $type ]]; then wl-paste -t "$type" >"$tmp" 2>/dev/null || type=""; fi
  printf '%s' "$1" | wl-copy || rc=1
  ((rc)) || herdr-app do terminal.paste >/dev/null || rc=1
  sleep 0.3 # let herdr-app read the clipboard before we restore it
  if [[ -n $type ]]; then wl-copy -t "$type" <"$tmp"; else wl-copy --clear; fi
  rm -f "$tmp"
  return $rc
}

# fence <text>: a backtick fence longer than any backtick run in <text>
fence() { local f='```'; while [[ $1 == *"$f"* ]]; do f+='`'; done; printf '%s' "$f"; }

# "path#Lx-y" for the selection (ZED_ROW is normally its start; tolerate it being the end)
mention_ref() {
  local root=$1 file=$2 row=$3 sel=$4 n start s ref
  if [[ $file != "$root"/* ]]; then file=$(realpath "$file") root=$(realpath "$root"); fi
  ref=${file#"$root"/}
  n=$(printf '%s\n' "$sel" | wc -l)
  start=$row
  for s in "$row" $((row - n + 1)) $((row - n)); do
    ((s >= 1)) && [[ $(sed -n "${s},$((s + n - 1))p" "$file") == *"$sel"* ]] && { start=$s; break; }
  done
  ((n > 1)) && echo "$ref#L$start-$((start + n - 1))" || echo "$ref#L$start"
}

# at <ref>: Claude's @ parser stops at a space unless the ref is quoted
at() { [[ $1 == *' '* ]] && echo "@\"$1\"" || echo "@$1"; }

# ask_note: prompt a one-line note (Esc = none)
ask_note() { local n; n=$(omarchy-menu-input "Review note (Esc = none)" 2>/dev/null) || n=""; printf '%s' "${n%%$'\n'*}"; }

# add_item <root> <file> <row> <selection> <note>: queue an item (caller holds the lock)
add_item() {
  local root=$1 ref f tmp
  ref=$(mention_ref "$1" "$2" "$3" "$4")
  f=$(batch_file "$root")
  mkdir -p "$(dirname "$f")"
  [[ -s $f ]] || echo '[]' >"$f"
  tmp=$(mktemp "$f.XXXXXX")
  jq --arg p "${ref%%#*}" --arg l "${ref##*#}" --arg s "$4" --arg n "$5" \
    '. + [{path: $p, lines: $l, selection: $s, note: $n}]' "$f" >"$tmp" && mv "$tmp" "$f" || { rm -f "$tmp"; return 1; }
}

# batch_message <root>: the text submitted to the agent (selections trimmed to 20 lines)
batch_message() {
  jq -r 'def code: (.selection | split("\n")) as $l | (if ($l | length) > 20 then $l[:20] + ["..."] else $l end) | join("\n");
    def fenced: . as $c | ("```" | until(. as $f | $c | contains($f) | not; . + "`")) as $f | "\($f)\n\($c)\n\($f)";
    "Review comments:\n\n" + (to_entries | map("\(.key + 1). \("\(.value.path)#\(.value.lines)" | if test(" ") then "@\"\(.)\"" else "@\(.)" end)\n\(.value | code | fenced)"
      + (if .value.note != "" then "\n\(.value.note)" else "" end)) | join("\n\n"))' "$(batch_file "$1")"
}

# submit_batch <root> <terminal>: focus, then hc send (paste + Enter by id; never --force).
# The batch is cleared only when hc send succeeds. Caller holds the lock.
submit_batch() {
  local root=$1 term=$2
  focus "$term" || { notify "Could not focus $term; batch kept"; return 1; }
  if hc send "$term" "$(batch_message "$root")" >/dev/null; then
    rm -f "$(batch_file "$root")"
  else
    notify "Send to $term failed; batch kept"
    return 1
  fi
}

# Zed task env (positional args are only a fallback): sets root file row sel
zed_ctx() {
  file=${ZED_FILE:-${2:-}} row=${ZED_ROW:-${3:-}} sel=${ZED_SELECTED_TEXT:-}
  root=${ZED_WORKTREE_ROOT:-${1:-}}
  if [[ -n $file ]]; then root=$(root_of "$(dirname "$file")") || root=""
  else root=$(root_of "$root") || root=""; sel=""; fi
  sel=${sel%$'\n'}
  [[ -n $root ]] || { notify "No project root"; exit 1; }
}

cmd=${1:-}; shift || true
case $cmd in
send)
  zed_ctx "$@"
  tgt=$(target_for "$root") || { notify "No herdr agent in $root"; exit 1; }
  read -r term status <<<"$tgt"
  if ((  $(batch_count "$root") > 0 )) || [[ -n $sel ]]; then
    if [[ $status == blocked ]]; then
      focus "$term" || true
      notify "Agent $term is blocked; nothing sent"
      exit 1
    fi
  fi
  if ((  $(batch_count "$root") > 0 )); then
    note=""
    [[ -z $sel ]] || note=$(ask_note)
    lock
    [[ -z $sel ]] || add_item "$root" "$file" "$row" "$sel" "$note"
    if ((  $(batch_count "$root") > 0 )); then submit_batch "$root" "$term" || exit 1; else focus "$term"; fi
  elif [[ -n $sel ]]; then
    focus "$term" || { notify "Could not focus $term; selection not sent"; exit 1; }
    fen=$(fence "$sel")
    paste_focused "$(at "$(mention_ref "$root" "$file" "$row" "$sel")")"$'\n'"$fen"$'\n'"$sel"$'\n'"$fen"$'\n' || { notify "Paste failed"; exit 1; }
  else
    focus "$term"
  fi
  ;;
add)
  zed_ctx "$@"
  [[ -n $file && -n $row ]] || { notify "No file open; nothing to queue"; exit 1; }
  [[ -n $sel ]] || sel=$(sed -n "${row}p" "$file")
  note=$(ask_note)
  lock
  add_item "$root" "$file" "$row" "$sel" "$note"
  n=$(batch_count "$root")
  notify "$n comment$( ((n == 1)) || echo s) queued for $(basename "$root")"
  ;;
clear)
  root=$(root_of "${ZED_WORKTREE_ROOT:-${1:-}}") || { notify "No project root"; exit 1; }
  lock
  rm -f "$(batch_file "$root")"
  notify "Batch cleared"
  ;;
*)
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
