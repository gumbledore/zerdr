#!/usr/bin/env bash
# zh — glue between Zed and the herdr-app agents.
#   zh send <root> <file> <row>   ctrl-space: focus the repo's agent, or paste the selection (no Enter)
#   zh add <root> <file> <row>    ctrl-shift-space: queue selection (or cursor line) + one-line note
#   zh clear <root>               drop the repo's batch
# With a batch, send submits it (after prompting a note for any selection).
# The selection arrives via ZED_SELECTED_TEXT (Zed word-splits task args).
set -euo pipefail

TERM_CLASS=${ZH_TERMINAL_CLASS:-herdr-app}
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/zerdr

notify() { notify-send "zh" "$1" 2>/dev/null || true; }
root_of() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || echo "$1"; }

# batch file for a git root: one per root, items {path, lines, selection, note}
batch_file() { echo "$STATE/batch/$(sha1sum <<<"$1" | cut -c1-16).json"; }
batch_count() { local f; f=$(batch_file "$1"); [[ -s $f ]] && jq 'length' "$f" || echo 0; }

# Target agent terminal for a git root: the one last focused in herdr-app if it is among
# the repo's local, live, status-reporting terminals, else blocked > done > working > idle.
# Prints "<terminal> <status>"; fails when there is none.
target_for() {
  local cands cwd t s focused
  cands=$(hc ls --json | jq -r '.terminals[]
    | select((.address | contains("/") | not) and (.machine == null) and .state == "live" and .status != null)
    | "\(.address)\t\(.status)\t\(.cwd // "")"')
  focused=$(herdr-app status 2>/dev/null | jq -r '.agent // empty' 2>/dev/null || true)
  local -a ids=() sts=()
  while IFS=$'\t' read -r t s cwd; do
    [[ -n $t && $(root_of "$cwd") == "$1" ]] || continue
    ids+=("$t") sts+=("$s")
  done <<<"$cands"
  ((${#ids[@]})) || return 1
  local i best=-1 bestrank=9 rank
  for i in "${!ids[@]}"; do
    [[ -n $focused && ${ids[i]} == "$focused" ]] && { echo "${ids[i]} ${sts[i]}"; return 0; }
    case ${sts[i]} in blocked) rank=0 ;; done) rank=1 ;; working) rank=2 ;; idle) rank=3 ;; *) rank=4 ;; esac
    ((rank < bestrank)) && { best=$i bestrank=$rank; }
  done
  echo "${ids[best]} ${sts[best]}"
}

# focus an agent and raise the herdr-app window
focus() {
  herdr-app do agent.focus --terminal "$1" >/dev/null
  # Hyprland >= 0.56 takes Lua dispatchers; older takes the classic syntax
  if command -v hyprctl >/dev/null; then
    hyprctl dispatch "hl.dsp.focus({ window = \"class:$TERM_CLASS\" })" | grep -q '^ok' ||
      hyprctl dispatch focuswindow "class:$TERM_CLASS" >/dev/null || true
  fi
}

# paste text into the focused terminal without Enter. hc send always presses Enter and
# hc keys cannot type arbitrary text, so go through the clipboard (restored afterwards).
paste_focused() {
  local old had=0
  old=$(wl-paste 2>/dev/null) && had=1
  printf '%s' "$1" | wl-copy
  herdr-app do terminal.paste >/dev/null
  sleep 0.2 # let herdr-app read the clipboard before we restore it
  ((had)) && printf '%s' "$old" | wl-copy
  return 0
}

# "@path#Lx-y" for the selection (ZED_ROW is normally its start; tolerate it being the end)
mention_ref() {
  local root=$1 file=$2 row=$3 sel=$4 n start s ref="@${2#"$1"/}"
  n=$(printf '%s\n' "$sel" | wc -l)
  start=$row
  for s in "$row" $((row - n + 1)) $((row - n)); do
    ((s >= 1)) && [[ $(sed -n "${s},$((s + n - 1))p" "$file") == *"$sel"* ]] && { start=$s; break; }
  done
  ((n > 1)) && echo "$ref#L$start-$((start + n - 1))" || echo "$ref#L$start"
}

# add_item <root> <file> <row> <selection>: prompt a one-line note (Esc = none) and queue it
add_item() {
  local root=$1 ref note f
  ref=$(mention_ref "$1" "$2" "$3" "$4") ref=${ref#@}
  note=$(omarchy-menu-input "Review note (Esc = none)" 2>/dev/null) || note=""
  f=$(batch_file "$root")
  mkdir -p "$(dirname "$f")"
  [[ -s $f ]] || echo '[]' >"$f"
  jq --arg p "${ref%%#*}" --arg l "${ref##*#}" --arg s "$4" --arg n "${note%%$'\n'*}" \
    '. + [{path: $p, lines: $l, selection: $s, note: $n}]' "$f" >"$f.tmp" && mv "$f.tmp" "$f"
}

# batch_message <root>: the text submitted to the agent (selections trimmed to 20 lines)
batch_message() {
  jq -r 'def code: (.selection | split("\n")) as $l | (if ($l | length) > 20 then $l[:20] + ["..."] else $l end) | join("\n");
    "Review comments:\n\n" + (to_entries | map("\(.key + 1). @\(.value.path)#\(.value.lines)\n```\n\(.value | code)\n```"
      + (if .value.note != "" then "\n\(.value.note)" else "" end)) | join("\n\n"))' "$(batch_file "$1")"
}

# send_batch <root> <terminal> <status> <selection>: rows 3-4 of the truth table
send_batch() {
  local root=$1 term=$2 status=$3 sel=$4 f
  if [[ $status == blocked ]]; then
    focus "$term"
    notify "Agent $term is blocked; batch kept"
    return 1
  fi
  [[ -n $sel ]] && add_item "$root" "$file" "$row" "$sel"
  focus "$term"
  # like hc send, pause between paste and Enter so the agent sees one paste, then submit
  paste_focused "$(batch_message "$root")" && sleep "${ZH_PASTE_GAP:-0.5}" && hc keys "$term" enter >/dev/null && rm -f "$(batch_file "$root")"
}

cmd=${1:-}; shift || true
case $cmd in
send)
  root=$(root_of "$1") file=$2 row=$3 sel=${ZED_SELECTED_TEXT:-}
  sel=${sel%$'\n'}
  tgt=$(target_for "$root") || { notify "No herdr agent in $root"; exit 1; }
  read -r term status <<<"$tgt"
  if ((  $(batch_count "$root") > 0 )); then
    send_batch "$root" "$term" "$status" "$sel" || exit 1
    exit 0
  elif [[ -n $sel ]]; then
    focus "$term"
    if [[ $status == blocked ]]; then
      notify "Agent $term is blocked; selection not sent"
    else
      paste_focused "$(mention_ref "$root" "$file" "$row" "$sel")"$'\n```\n'"$sel"$'\n```\n'
    fi
    exit 0
  fi
  focus "$term"
  ;;
add)
  root=$(root_of "$1") file=$2 row=$3 sel=${ZED_SELECTED_TEXT:-}
  sel=${sel%$'\n'}
  [[ -n $sel ]] || sel=$(sed -n "${row}p" "$file")
  add_item "$root" "$file" "$row" "$sel"
  n=$(batch_count "$root")
  notify "$n comment$( ((n == 1)) || echo s) queued for $(basename "$root")"
  ;;
clear)
  rm -f "$(batch_file "$(root_of "$1")")"
  notify "Batch cleared"
  ;;
*)
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
