[
  {
    "label": "herdr: focus agent",
    "command": "@ZH@",
    "args": ["focus", "$ZED_WORKTREE_ROOT"],
    "reveal": "never",
    "hide": "always",
    "allow_concurrent_runs": true
  },
  {
    "label": "herdr: send file/selection to agent",
    "command": "@ZH@",
    "args": ["mention", "$ZED_WORKTREE_ROOT", "$ZED_FILE", "$ZED_ROW"],
    "reveal": "never",
    "hide": "always",
    "allow_concurrent_runs": true
  }
]
